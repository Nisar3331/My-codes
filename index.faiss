from __future__ import annotations
from typing import Dict, Any, Optional
from google.cloud import logging as cloud_logging
from google.auth import default


def get_gcp_logging_client(instance: Dict[str, Any]) -> cloud_logging.Client:
    """Get GCP Cloud Logging client with support for multiple auth methods.

    Supports:
      - default: Application Default Credentials (ADC)
      - service_account_key: Path to service account JSON key file
    """
    auth = instance.get('auth') or {}
    method = auth.get('method', 'default')
    project_id = instance.get('project_id') or instance.get('meta', {}).get('project_id')

    if method == 'default':
        # Use Application Default Credentials
        return cloud_logging.Client(project=project_id)

    if method == 'service_account_key':
        # Load from service account key file
        key_path = auth.get('key_path')
        if not key_path:
            raise ValueError('service_account_key method requires key_path')
        # Cloud logging client can load from GOOGLE_APPLICATION_CREDENTIALS env var
        # or we can pass credentials explicitly via import
        from google.oauth2 import service_account
        credentials = service_account.Credentials.from_service_account_file(key_path)
        return cloud_logging.Client(project=project_id, credentials=credentials)

    raise ValueError(f"Unsupported GCP auth method: {method}")


def get_gcp_composer_oidc_token(audience: str) -> str:
    """Get OIDC ID token for Cloud Composer IAP access."""
    from google.auth.transport.requests import Request
    from google.oauth2 import id_token
    return id_token.fetch_id_token(Request(), audience)
